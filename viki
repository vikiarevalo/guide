from bs4 import BeautifulSoup
import time
import smtplib
from email.mime.text import MIMEText

# CONFIGURATION
URL = "https://m.popmart.com/us/pop-now/set/195"
CHECK_INTERVAL = 60  # Time between checks in seconds

# Email Setup (You must enable app password for Gmail)
EMAIL_ADDRESS = "your.email@example.com"
EMAIL_PASSWORD = "your_app_password"
RECIPIENT_EMAIL = "your.email@example.com"

def check_stock():
    headers = {
        "User-Agent": "Mozilla/5.0"
    }
    response = requests.get(URL, headers=headers)
    soup = BeautifulSoup(response.text, 'html.parser')

    # Check for "Sold Out" text
    return "Sold Out" not in soup.text

def send_email():
    subject = "🚨 Pop Mart Restock Alert!"
    body = f"The product may be in stock! Check it now: {URL}"
    msg = MIMEText(body)
    msg["Subject"] = subject
    msg["From"] = EMAIL_ADDRESS
    msg["To"] = RECIPIENT_EMAIL

    with smtplib.SMTP_SSL("smtp.gmail.com", 465) as server:
        server.login(EMAIL_ADDRESS, EMAIL_PASSWORD)
        server.send_message(msg)

def main():
    print("🔍 Starting Pop Mart stock monitor...")
    while True:
        try:
            if check_stock():
                print("✅ Product appears to be in stock! Sending email...")
                send_email()
                break
            else:
                print("❌ Still sold out. Checking again in 60 seconds...")
        except Exception as e:
            print(f"⚠ Error: {e}")
        time.sleep(CHECK_INTERVAL)

if _name_ == "_main_":
    main()
